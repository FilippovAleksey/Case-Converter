<idea-plugin>
    <id>me.filippov.case-converter</id>
    <name>Case Converter</name>
    <vendor>Filippov</vendor>
    <description><![CDATA[
        Renames symbols to snake_case or camelCase using IDE Rename Refactoring.
        Includes configurable conversion rules and local usage statistics with charts.
        Переименование символов с обновлением ссылок, настройки и локальная статистика.
    ]]></description>
    <!-- Общий редактор платформы: зависимость от Python не нужна. -->
    <depends>com.intellij.modules.lang</depends>
    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable id="me.filippov.caseconverter.settings"
            parentId="tools" displayName="Case Converter"
            instance="me.filippov.caseconverter.SettingsConfigurable"/>
        <toolWindow id="Case Converter" anchor="right"
            factoryClass="me.filippov.caseconverter.StatisticsToolWindowFactory"
            icon="AllIcons.Toolwindows.ToolWindowPalette"/>
    </extensions>
    <actions>
        <!-- Эти ID доступны в Settings → Keymap для назначения горячих клавиш. -->
        <group id="CaseConverter.Menu" text="Case Converter" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="CaseConverter.ToSnakeCase" text="Переименовать символ в snake_case…"
                class="me.filippov.caseconverter.ToSnakeCaseAction"/>
            <action id="CaseConverter.ToCamelCase" text="Переименовать символ в camelCase…"
                class="me.filippov.caseconverter.ToCamelCaseAction"/>
        </group>
    </actions>
</idea-plugin>
